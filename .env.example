# Copy to .env. Do not commit secrets.
# Local dev only (FastAPI Cloud sets host/port for you):
APP_HOST=127.0.0.1
APP_PORT=8000
# Times are shown in the machine's local zone. Override with an IANA name,
# for example Asia/Kolkata.
# APP_TIMEZONE=
DATA_DIR=./data
DATABASE_URL=sqlite:///./data/studio.db
MAX_IMAGE_BYTES=15728640
MAX_AUDIO_BYTES=20971520

# Use this pair for Kaggle's current token format, or omit both and install
# ~/.kaggle/kaggle.json with chmod 600. Never commit either credential source.
# KAGGLE_USERNAME=
# KAGGLE_API_TOKEN=

# Stable PRIVATE Kaggle resources reused for every serialized job.
KAGGLE_DATASET_SLUG=video-studio-jobs
KAGGLE_KERNEL_SLUG=video-studio-runner
# KAGGLE_RUNNER_DIR=./kaggle_runner
# KAGGLE_POLL_INITIAL_SECONDS=10
# KAGGLE_POLL_MAX_SECONDS=60
# KAGGLE_DATASET_READY_TIMEOUT_SECONDS=600
# Some accounts cannot read kernel status at all. Give up after this long.
# KAGGLE_UNKNOWN_STATUS_TIMEOUT_SECONDS=900
# T4-safe quality keyframes. Use stabilityai/sdxl-turbo for faster previews.
# FLUX.1-schnell remains selectable after accepting its license and attaching a
# Kaggle kernel secret labelled HF_TOKEN.
# STILL_MODEL=stabilityai/stable-diffusion-xl-base-1.0

# --- FastAPI Cloud (https://fastapicloud.com) ---
# Set KAGGLE_USERNAME + KAGGLE_API_TOKEN as *secrets* in the dashboard or:
#   fastapi cloud env set --secret KAGGLE_USERNAME "..."
#   fastapi cloud env set --secret KAGGLE_API_TOKEN "..."
# Run Kaggle bootstrap once locally (/setup on 127.0.0.1), then: fastapi deploy
# Full checklist: docs/DEPLOY-FASTAPI-CLOUD.md
